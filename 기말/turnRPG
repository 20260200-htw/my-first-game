SKILL_PHYSICAL = "physical"
SKILL_MAGICAL  = "magical"
SKILL_BUFF     = "buff"
SKILL_CHARGE   = "charge"


class Skill:
    def __init__(self, name, skill_type, base_power=0,
                 hit_rate=1.0, mana_cost=0, description="", target="single",
                 anim_path=None, hit_times=None):
        self.name           = name
        self.skill_type     = skill_type
        self.base_power     = base_power
        self.hit_rate       = hit_rate
        self.mana_cost      = mana_cost
        self.description    = description
        self.target         = target
        # 애니메이션
        self.anim_path      = anim_path   # "assets/animations/xxx.gif"
        self.animation_time = get_gif_duration_ms(anim_path) if anim_path else 0
        self.hit_times      = hit_times or ([self.animation_time // 2]
                                           if self.animation_time else [0])

    def can_use(self, user):
        return user.mana >= self.mana_cost

    def calc_damage(self, user):
        if self.skill_type == SKILL_PHYSICAL:
            return self.base_power + (user.physical_level + getattr(user, "_tmp_phys", 0)) * 5
        if self.skill_type == SKILL_MAGICAL:
            return self.base_power + (user.magic_level + getattr(user, "_tmp_mag", 0)) * 5
        return 0

    def roll_hit(self, user, target):
        uh  = self.hit_rate + getattr(user, "hit_bonus", 0) / 100
        te  = getattr(target, "evasion", 0) / 100 + getattr(target, "_tmp_eva", 0) / 100
        return random.random() < (uh - te)

    def apply(self, user, targets):
        results = []
        user.mana = max(0, user.mana - self.mana_cost)

        if self.skill_type in (SKILL_PHYSICAL, SKILL_MAGICAL):
            for t in targets:
                if self.roll_hit(user, t):
                    dmg = max(1, self.calc_damage(user))
                    t.hp = max(0, t.hp - dmg)
                    results.append(("hit", t, dmg))
                else:
                    results.append(("miss", t, 0))

        elif self.skill_type == SKILL_BUFF:
            if self.name == "마력 집중":
                user._tmp_mag   = getattr(user, "_tmp_mag", 0) + 10
                user.hit_bonus  = getattr(user, "hit_bonus", 0) + 50
            results.append(("buff", user, 0))

        elif self.skill_type == SKILL_CHARGE:
            rec = int(user.max_mana * 0.5)
            user.mana = min(user.max_mana, user.mana + rec)
            results.append(("charge", user, rec))

        return results


