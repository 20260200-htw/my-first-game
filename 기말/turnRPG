def draw_text(surf, text, font, color, x, y, max_width=None):
    if max_width:
        words, lines, line = text.split(" "), [], ""
        for w in words:
            test = line + w + " "
            if font.size(test)[0] > max_width and line:
                lines.append(line); line = w + " "
            else:
                line = test
        lines.append(line)
        for i, l in enumerate(lines):
            img = font.render(l, True, color)
            surf.blit(img, (x, y + i * (font.get_height() + 2)))
        return len(lines) * (font.get_height() + 2)
    img = font.render(text, True, color)
    surf.blit(img, (x, y))
    return font.get_height()


def draw_text_centered(surf, text, font, color, cx, y):
    """cx 기준 수평 중앙 정렬로 텍스트 그리기"""
    img = font.render(text, True, color)
    surf.blit(img, (cx - img.get_width()//2, y))
    return img.get_height()


def draw_bar(surf, x, y, w, h, val, max_val, fg, bg=DARK_GRAY):
    pygame.draw.rect(surf, bg, (x, y, w, h))
    fill = int(w * max(0, val) / max(1, max_val))
    if fill: pygame.draw.rect(surf, fg, (x, y, fill, h))
    pygame.draw.rect(surf, (80, 80, 80), (x, y, w, h), 1)


def draw_panel(surf, x, y, w, h, alpha=200, color=(15, 15, 30)):
    s = pygame.Surface((w, h), pygame.SRCALPHA)
    s.fill((*color, alpha))
    surf.blit(s, (x, y))
    pygame.draw.rect(surf, (70, 70, 110), (x, y, w, h), 2)


class Button:
    def __init__(self, x, y, w, h, text, font_key="small",
                 color=DARK_GRAY, hover_color=GRAY,
                 text_color=WHITE, border_color=(100, 100, 160)):
        self.rect        = pygame.Rect(x, y, w, h)
        self.text        = text
        self.font_key    = font_key
        self.color       = color
        self.hover_color = hover_color
        self.text_color  = text_color
        self.border_color= border_color
        self.hovered     = False
        self.enabled     = True

    def draw(self, surf):
        col = self.hover_color if (self.hovered and self.enabled) else self.color
        if not self.enabled:
            col = (25, 25, 35)
        pygame.draw.rect(surf, col, self.rect, border_radius=6)
        pygame.draw.rect(surf, self.border_color if self.enabled else GRAY,
                         self.rect, 2, border_radius=6)
        tc = self.text_color if self.enabled else GRAY
        img = f(self.font_key).render(self.text, True, tc)
        surf.blit(img, img.get_rect(center=self.rect.center))

    def update(self, mouse):
        self.hovered = self.rect.collidepoint(mouse)

    def is_clicked(self, event):
        return (self.enabled
                and event.type == pygame.MOUSEBUTTONDOWN
                and event.button == 1
                and self.rect.collidepoint(event.pos))


class ScrollLog:
    def __init__(self, x, y, w, h):
        self.rect  = pygame.Rect(x, y, w, h)
        self.lines = []
        self.scroll= 0

    def append(self, text):
        for line in text.split("\n"):
            self.lines.append(line)
        lh = f("small").get_height() + 3
        self.scroll = max(0, len(self.lines) * lh - self.rect.h)

    def handle_event(self, event):
        if event.type == pygame.MOUSEWHEEL and self.rect.collidepoint(pygame.mouse.get_pos()):
            lh = f("small").get_height() + 3
            ms = max(0, len(self.lines) * lh - self.rect.h)
            self.scroll = max(0, min(ms, self.scroll - event.y * lh))

    def draw(self, surf):
        clip = surf.get_clip()
        surf.set_clip(self.rect)
        lh = f("small").get_height() + 3
        for i, line in enumerate(self.lines):
            ry = self.rect.y + i * lh - int(self.scroll)
            if ry + lh < self.rect.y or ry > self.rect.bottom:
                continue
            # 최신 줄일수록 밝게
            age   = len(self.lines) - i
            alpha = max(80, 255 - age * 18)
            col   = (min(255, alpha), min(255, alpha), min(255, alpha))
            img   = f("small").render(line, True, col)
            surf.blit(img, (self.rect.x + 6, ry))
        surf.set_clip(clip)


