class Entity:
    def __init__(self, name, hp, speed, physical_level, magic_level,
                 hit_rate=0, evasion=0, mana=100):
        self.name           = name
        self.max_hp         = hp
        self.hp             = hp
        self.speed          = speed
        self.physical_level = physical_level
        self.magic_level    = magic_level
        self.hit_bonus      = hit_rate
        self.evasion        = evasion
        self.max_mana       = mana
        self.mana           = mana
        self._tmp_phys = 0
        self._tmp_mag  = 0
        self._tmp_eva  = 0

    @property
    def alive(self): return self.hp > 0

    def regen_mana(self):
        self.mana = min(self.max_mana, self.mana + max(1, int(self.max_mana * 0.10)))

    def reset_tmp(self):
        self._tmp_phys = 0
        self._tmp_mag  = 0
        self._tmp_eva  = 0


class Player(Entity):
    def __init__(self, data=None):
        if data:
            self._load(data); return
        super().__init__("플레이어", PLAYER_BASE_HP, PLAYER_BASE_SPEED, 0, 0, 0, 0, 100)
        self.level         = 1
        self.exp           = 0
        self.exp_to_next   = 100
        self.spec_points   = 10   # 레벨 1 초기 지급
        self.base_points   = 10   # 레벨 1 초기 지급
        self.stat_hp       = 0
        self.stat_speed    = 0
        self.stat_hit      = 0
        self.stat_evasion  = 0
        self.stat_physical = 0
        self.stat_magic    = 0
        self.skills        = [SK_SLASH, SK_BULLET, SK_FOCUS]
        self.passives      = []
        self.inventory     = []
        self._load_anims()

    def _load_anims(self):
        """플레이어 GIF 애니메이션 로드 + 좌우 반전"""
        BASE = "assets/animations"
        self.anim_frames = {}
        self.anim_durations = {}
        for key, fname in [
            ("idle",  "player_idle.gif"),
            ("melee", "player_melee.gif"),
            ("magic", "player_magic.gif"),
        ]:
            path = os.path.join(BASE, fname)
            frames, durs = load_gif_frames(path)
            # 좌우 반전
            frames = [pygame.transform.flip(fr, True, False) for fr in frames]
            self.anim_frames[key]    = frames
            self.anim_durations[key] = durs
        # 현재 재생 상태
        self.anim_key     = "idle"
        self.anim_frame   = 0
        self.anim_elapsed = 0.0   # ms

    def update_anim(self, dt_ms):
        """dt_ms: 델타타임(ms). 프레임 전진."""
        frames = self.anim_frames.get(self.anim_key, [])
        durs   = self.anim_durations.get(self.anim_key, [])
        if not frames: return
        self.anim_elapsed += dt_ms
        dur = durs[self.anim_frame] if self.anim_frame < len(durs) else 100
        while self.anim_elapsed >= dur:
            self.anim_elapsed -= dur
            self.anim_frame = (self.anim_frame + 1) % len(frames)
            dur = durs[self.anim_frame] if self.anim_frame < len(durs) else 100

    def set_anim(self, key):
        if self.anim_key != key:
            self.anim_key     = key
            self.anim_frame   = 0
            self.anim_elapsed = 0.0

    def get_anim_surface(self):
        frames = self.anim_frames.get(self.anim_key, [])
        if not frames: return None
        return frames[self.anim_frame % len(frames)]

    def _recalc(self):
        self.max_hp         = PLAYER_BASE_HP + self.stat_hp * 10
        self.hp             = min(self.hp, self.max_hp)
        self.speed          = PLAYER_BASE_SPEED + self.stat_speed * 2
        self.physical_level = self.stat_physical
        self.magic_level    = self.stat_magic
        self.hit_bonus      = min(10, self.stat_hit)
        self.evasion        = min(10, self.stat_evasion)

    def level_up(self):
        self.level += 1; self.spec_points += 1; self.base_points += 1
        self.exp_to_next = int(self.exp_to_next * 1.2)

    def gain_exp(self, amount):
        msgs = []
        self.exp += amount
        while self.exp >= self.exp_to_next and self.level < PLAYER_MAX_LEVEL:
            self.exp -= self.exp_to_next
            self.level_up(); self._recalc()
            msgs.append(f"레벨 업! Lv.{self.level}")
        return msgs

    def invest_spec(self, stat):
        if self.spec_points <= 0: return False
        if stat == "physical" and self.stat_physical < MAX_SPECIALIZED:
            self.stat_physical += 1
        elif stat == "magic" and self.stat_magic < MAX_SPECIALIZED:
            self.stat_magic += 1
        else: return False
        self.spec_points -= 1; self._recalc(); return True

    def invest_base(self, stat):
        if self.base_points <= 0: return False
        m = {"hp":"stat_hp","speed":"stat_speed","hit":"stat_hit","evasion":"stat_evasion"}
        a = m.get(stat)
        if a and getattr(self, a) < MAX_BASE_STAT:
            setattr(self, a, getattr(self, a) + 1)
            self.base_points -= 1; self._recalc(); return True
        return False

    def to_dict(self):
        return {k: getattr(self, k) for k in
                ["hp","max_hp","mana","max_mana","speed","level","exp","exp_to_next",
                 "spec_points","base_points","stat_hp","stat_speed","stat_hit",
                 "stat_evasion","stat_physical","stat_magic","inventory"]}

    def _load(self, d):
        super().__init__("플레이어", d["hp"], d["speed"],
                         d["stat_physical"], d["stat_magic"],
                         d["stat_hit"], d["stat_evasion"], d["mana"])
        for k in ["max_hp","max_mana","level","exp","exp_to_next","spec_points",
                  "base_points","stat_hp","stat_speed","stat_hit","stat_evasion",
                  "stat_physical","stat_magic"]:
            setattr(self, k, d[k])
        self.inventory = d.get("inventory", [])
        self.skills = [SK_SLASH, SK_BULLET, SK_FOCUS]
        self.passives = []
        self._load_anims()


class Enemy(Entity):
    def __init__(self, tmpl, level=1):
        self.template    = tmpl
        self.enemy_level = level
        self.base_exp    = tmpl["base_exp"]
        phys, mag = self._calc_spec(tmpl, level)
        hp = tmpl["base_hp"] + tmpl.get("hp_per_level", 5) * (level - 1)
        super().__init__(tmpl["name"], hp, tmpl["base_speed"],
                         phys, mag, tmpl.get("hit_rate", 0),
                         tmpl.get("evasion", 0), tmpl.get("base_mana", 50))
        self.max_mana = tmpl.get("base_mana", 50)
        self.skills   = list(tmpl["skills"])
        self.passives = list(tmpl["passives"])
        self.info     = tmpl.get("info", "")

    @staticmethod
    def _calc_spec(tmpl, level):
        phys, mag = tmpl["base_physical"], tmpl["base_magic"]
        for lv in range(2, level + 1):
            if lv % 5 == 0: mag += 1
            else: phys += 1
        return phys, mag

    def choose_skill(self):
        usable = [s for s in self.skills if s.name != "마력 충전" and s.can_use(self)]
        return random.choice(usable) if usable else SK_MANACHARGE

    def exp_reward(self): return self.base_exp * self.enemy_level

    def trigger_on_attacked(self, attacker, skill):
        for p in self.passives:
            p.on_attacked(self, attacker, skill)


