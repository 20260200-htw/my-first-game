    _PIL_AVAILABLE = True
except ImportError:
    _PIL_AVAILABLE = False


def get_gif_duration_ms(path):
    """GIF 파일의 총 재생시간(ms) 반환. Pillow 없으면 0 반환."""
    if not _PIL_AVAILABLE or not os.path.exists(path):
        return 0
    try:
        img = PilImage.open(path)
        total = 0
        while True:
            total += img.info.get("duration", 100)
            img.seek(img.tell() + 1)
    except EOFError:
        pass
    return total


def load_gif_frames(path):
    """GIF를 pygame Surface 프레임 리스트와 ms 단위 지속시간 리스트로 반환.
    파일 없으면 ([], []) 반환."""
    if not _PIL_AVAILABLE or not os.path.exists(path):
        return [], []
    try:
        pil_img = PilImage.open(path)
        frames, durations = [], []
        while True:
            frame = pil_img.convert("RGBA")
            w, h  = frame.size
            data  = frame.tobytes()
            surf  = pygame.image.fromstring(data, (w, h), "RGBA")
            frames.append(surf)
            durations.append(pil_img.info.get("duration", 100))
            pil_img.seek(pil_img.tell() + 1)
    except EOFError:
        pass
    return frames, durations


